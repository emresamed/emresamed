{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://emresamed.local/schemas/exercise.schema.json",
  "title": "Exercise",
  "description": "A single resistance-training exercise. Authored by Agent 2; consumed by Agents 3, 4, 5. Enums refer to data/enums.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "primary_muscle_group",
    "primary_target_zone",
    "mechanics",
    "force",
    "required_equipment",
    "difficulty",
    "fatigue_index"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
      "description": "Stable upper-snake-case identifier, e.g. BB_BENCH_PRESS."
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "primary_muscle_group": {
      "type": "string",
      "enum": ["CHEST", "BACK", "SHOULDERS", "ARMS", "LEGS", "CORE"]
    },
    "primary_target_zone": {
      "type": "string",
      "description": "Must be a TargetZone whose parent matches primary_muscle_group. Cross-field validation is Agent 5's responsibility."
    },
    "secondary_muscle_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["CHEST", "BACK", "SHOULDERS", "ARMS", "LEGS", "CORE"]
      },
      "default": []
    },
    "secondary_target_zones": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "default": []
    },
    "mechanics": { "type": "string", "enum": ["COMPOUND", "ISOLATION"] },
    "force": {
      "type": "string",
      "enum": ["PUSH", "PULL", "SQUAT", "HINGE", "LUNGE", "CARRY", "STATIC", "ROTATION"]
    },
    "movement_plane": {
      "type": "string",
      "enum": ["SAGITTAL", "FRONTAL", "TRANSVERSE"],
      "default": "SAGITTAL"
    },
    "required_equipment": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Subset of data/enums.json#/Equipment. BODYWEIGHT is allowed as the single entry."
    },
    "difficulty": {
      "type": "string",
      "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"]
    },
    "fatigue_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Systemic cost. Used by the picker to order PRIMARY_COMPOUND slots."
    },
    "default_tempo": {
      "type": "string",
      "pattern": "^[0-9X]-[0-9X]-[0-9X]-[0-9X]$",
      "description": "ecc-pause-conc-pause seconds; X means explosive."
    },
    "rom_priority": {
      "type": "string",
      "enum": ["PARTIAL", "FULL", "STRETCH_FOCUS"],
      "default": "FULL"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
      "default": []
    },
    "contraindications": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "HIGH_LUMBAR_LOAD", "DEEP_KNEE_FLEXION", "OVERHEAD_PRESSING",
          "WRIST_HYPEREXTENSION", "DEEP_HIP_FLEXION", "CERVICAL_LOAD",
          "VALSALVA_HEAVY", "BALLISTIC"
        ]
      },
      "default": []
    },
    "swap_candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
      "description": "Other exercise IDs that target the same primary_target_zone. UI-only.",
      "default": []
    },
    "instruction_cues": {
      "type": "array",
      "items": { "type": "string", "maxLength": 240 },
      "maxItems": 6,
      "default": []
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thumbnail_id": { "type": "string" },
        "video_id": { "type": "string" }
      }
    }
  }
}
