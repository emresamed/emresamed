{
  "name": "mobile-fitness-core",
  "version": "1.0.0",
  "description": "Type-safe onboarding, workout generation, and dark-mode UI for the mobile fitness app",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
