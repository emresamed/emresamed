{
  "expo": {
    "name": "GymBro",
    "slug": "gymbro",
    "scheme": "gymbro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymbro.app"
    },
    "android": {
      "package": "com.gymbro.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "appEnv": "development"
    }
  }
}
